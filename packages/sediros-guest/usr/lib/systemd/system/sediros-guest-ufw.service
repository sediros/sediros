[Unit]
Description=SedirOS: let the VM host reach SSH without the rate limit
Documentation=file:/usr/lib/systemd/system/sediros-guest-ufw.service
# Under `sediros launch` every SSH connection comes from QEMU's user-mode
# network gateway, 10.0.2.2, and the forwarded port only listens on the
# host's 127.0.0.1. UFW's "limit 22/tcp" (6 new connections in 30 s) adds
# no protection there, but the launcher's readiness probes trip it and
# block the next `sediros shell`. Allow that address before the limit rule;
# every other source stays rate-limited. ufw saves the rule, so this runs once.
After=ufw.service sediros-firstboot-ufw.service
Before=ssh.service
ConditionPathExists=!/var/lib/sediros/guest-ufw-initialized

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ufw insert 1 allow proto tcp from 10.0.2.2 to any port 22 comment sediros-launch
ExecStartPost=/usr/bin/install -D -m 0644 /dev/null /var/lib/sediros/guest-ufw-initialized

[Install]
WantedBy=multi-user.target
