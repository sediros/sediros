#!/bin/sh
# SedirOS live session setup (sedir-live.service, boot=live only).
# /etc here is the live overlay: changes are lost at power-off and never
# reach the squashfs that sedir-install copies.
set -eu

user="$(sed -n 's/^USER=//p' /etc/sedir/build-info)"
echo "$user" | grep -Eqx '[a-z_][a-z0-9_-]{0,31}' || { echo "sedir-live: no valid USER in build-info" >&2; exit 1; }
id "$user" >/dev/null

# The install profile ships an empty, expired password (first login must set
# one). In the live session the console logs in automatically instead.
passwd -l "$user" >/dev/null
chage -d -1 "$user"

umask 0337
printf '# SedirOS live session (RAM only)\n%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$user" \
    > /etc/sudoers.d/90-sedir-live
visudo -cqf /etc/sudoers.d/90-sedir-live

# A disk that sedir-install already installed to (LUKS label set by the
# installer): the machine probably booted this ISO again by mistake.
installed=""
for part in $(blkid -t LABEL=sedir-crypt -o device 2>/dev/null); do
    disk="$(lsblk -dno PKNAME "$part" 2>/dev/null || true)"
    installed="${installed:+$installed, }${disk:-$part}"
done

umask 022
{
if [ -n "$installed" ]; then
    cat <<WARN

  !! SedirOS is already installed on: $installed
  !! This is the installer ISO again, not the installed system: remove the
  !! ISO / USB stick (or move the disk first in the boot order) and reboot.
WARN
fi
cat <<MOTD

  SedirOS live session - nothing is written to disk.
  User '$user' has passwordless sudo here only.

  Install to a disk (erases it, LUKS-encrypted):
    sudo sedir-install disks
    sudo sedir-install install --disk <name>

MOTD
} > /etc/motd
