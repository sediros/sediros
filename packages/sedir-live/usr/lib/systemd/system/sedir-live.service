[Unit]
Description=SedirOS: live session setup (autologin user, passwordless sudo)
ConditionKernelCommandLine=boot=live
DefaultDependencies=no
After=local-fs.target
Before=getty-pre.target systemd-user-sessions.service
Wants=getty-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/sedir/live-setup

[Install]
WantedBy=sysinit.target
