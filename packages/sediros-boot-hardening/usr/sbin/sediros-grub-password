#!/bin/sh
# =============================================================================
#  sediros-grub-password - require a password for editing GRUB entries.
#
#  Usage: sediros-grub-password set [--stdin]   set or change the password
#         sediros-grub-password disable         remove it
#         sediros-grub-password status
#
#  With a password: the default entry boots without it (unattended reboots
#  keep working); editing an entry ('e', e.g. init=/bin/bash), the GRUB shell
#  ('c'), recovery entries and "UEFI Firmware Settings" require it.
#  Only a PBKDF2 hash is stored (/etc/sediros/grub-password, mode 0600).
# =============================================================================
set -eu

CONF=/etc/sediros/grub-password
LINUX=/etc/grub.d/10_linux
SUPERUSER=admin
ITERATIONS=100000
MIN_LEN=12

die() { echo "sediros-grub-password: $*" >&2; exit 1; }

update_grub() {
    if command -v update-grub >/dev/null 2>&1 && [ -d /boot/grub ]; then
        update-grub
    else
        echo "GRUB not installed here: configuration stored, applied on the next update-grub."
    fi
}

read_password() {
    if [ "${1:-}" = "--stdin" ]; then
        IFS= read -r pw || die "no password on stdin"
        pw2="$pw"
    else
        [ -t 0 ] || die "no terminal; use --stdin"
        trap 'stty echo' EXIT INT TERM
        stty -echo
        printf 'GRUB password: ' >&2; IFS= read -r pw; echo >&2
        printf 'Repeat: ' >&2;        IFS= read -r pw2; echo >&2
        stty echo
        trap - EXIT INT TERM
    fi
    [ "$pw" = "$pw2" ] || die "passwords do not match"
    [ "${#pw}" -ge "$MIN_LEN" ] || die "password must be at least $MIN_LEN characters"
}

cmd_set() {
    command -v grub-mkpasswd-pbkdf2 >/dev/null 2>&1 \
        || die "grub-mkpasswd-pbkdf2 not found (apt install grub2-common)"
    read_password "${1:-}"
    # The password goes through a pipe, never through argv.
    hash="$(printf '%s\n%s\n' "$pw" "$pw" \
            | grub-mkpasswd-pbkdf2 -c "$ITERATIONS" 2>/dev/null \
            | sed -n 's/.* \(grub\.pbkdf2\.sha512\.[^ ]*\)$/\1/p')"
    unset pw pw2
    [ -n "$hash" ] || die "grub-mkpasswd-pbkdf2 failed"

    mkdir -p "$(dirname "$CONF")"
    umask 077
    printf 'GRUB_SUPERUSER=%s\nGRUB_PBKDF2=%s\n' "$SUPERUSER" "$hash" > "$CONF.new"
    mv "$CONF.new" "$CONF"

    # Replace 10_linux by 10_sediros_linux; the override survives grub upgrades.
    if [ -e "$LINUX" ] && ! dpkg-statoverride --list "$LINUX" >/dev/null; then
        dpkg-statoverride --update --add root root 0644 "$LINUX"
    fi
    update_grub
    echo "GRUB password set (superuser '$SUPERUSER')."
}

cmd_disable() {
    rm -f "$CONF"
    if dpkg-statoverride --list "$LINUX" >/dev/null; then
        dpkg-statoverride --remove "$LINUX"
        chmod 0755 "$LINUX"
    fi
    update_grub
    echo "GRUB password removed."
}

cmd_status() {
    if [ -r "$CONF" ] && [ -e "$LINUX" ] && [ ! -x "$LINUX" ]; then
        echo "enabled (superuser '$(sed -n 's/^GRUB_SUPERUSER=//p' "$CONF")')"
    elif [ -r "$CONF" ]; then
        echo "configured but NOT active: $LINUX is executable (run: sediros-grub-password set)"
        return 1
    else
        echo "disabled"
    fi
}

[ "$(id -u)" -eq 0 ] || die "must run as root"
case "${1:-status}" in
    set)     shift; cmd_set "${1:-}" ;;
    disable) cmd_disable ;;
    status)  cmd_status ;;
    -h|--help) sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (set|disable|status)" ;;
esac
