#!/bin/sh
set -e
if [ "$1" = purge ]; then
    deb-systemd-helper purge sediros-firstboot.service >/dev/null || true
    rm -rf /var/lib/sediros/firstboot
    rm -f /etc/motd.d/50-sediros-firstboot
fi
if [ "$1" = remove ]; then
    deb-systemd-helper disable sediros-firstboot.service >/dev/null || true
fi
