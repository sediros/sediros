#!/bin/sh
# sediros-hardening postrm
set -e

UNITS="sediros-ssh-hostkeys.service sediros-firstboot-ufw.service sediros-netfilter.service"

case "$1" in
    remove)
        # Profiles are gone from /usr/share/pam-configs: drop them from the stack.
        pam-auth-update --package --remove sediros-faillock sediros-faillock-authfail || true
        if [ -d /run/systemd/system ]; then
            # The unit file is gone already: drop the table directly.
            nft delete table ip sediros 2>/dev/null || true
            systemctl daemon-reload || true
        fi
        ;;
    purge)
        for unit in $UNITS; do
            deb-systemd-helper purge "$unit" >/dev/null || true
        done
        rm -rf /var/lib/sediros
        ;;
esac

exit 0
