#!/bin/bash
# Remove setuid/setgid bits from every binary not in /etc/sedir/suid-allowlist.
set -euo pipefail

ALLOWLIST=/etc/sedir/suid-allowlist
declare -A keep=()
if [[ -r $ALLOWLIST ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
        line="${line%%#*}"
        line="${line//[[:space:]]/}"
        [[ -n $line ]] && keep["$line"]=1
    done < "$ALLOWLIST"
fi

dirs=()
for d in /usr /opt /etc /var; do [[ -d $d ]] && dirs+=("$d"); done

while IFS= read -r -d '' f; do
    if [[ -n "${keep[$f]:-}" ]]; then
        echo "keep  $f"
        continue
    fi
    chmod u-s,g-s -- "$f"
    echo "strip $f"
    logger -t sedir-suid-strip "stripped setuid/setgid: $f" 2>/dev/null || true
done < <(find "${dirs[@]}" -xdev -type f -perm /6000 -print0)
