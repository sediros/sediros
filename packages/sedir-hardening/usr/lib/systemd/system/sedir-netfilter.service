[Unit]
Description=SedirOS: extra packet filter (nftables)
Documentation=file:/etc/sedir/netfilter.nft
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/sedir/netfilter.nft
ExecReload=/usr/sbin/nft -f /etc/sedir/netfilter.nft
ExecStop=/usr/sbin/nft delete table ip sedir

[Install]
WantedBy=sysinit.target
