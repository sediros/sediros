#!/bin/sh
# sedir-hardening postrm
set -e

UNITS="sedir-ssh-hostkeys.service sedir-firstboot-ufw.service sedir-netfilter.service"

case "$1" in
    remove)
        # Profiles are gone from /usr/share/pam-configs: drop them from the stack.
        pam-auth-update --package --remove sedir-faillock sedir-faillock-authfail || true
        if [ -d /run/systemd/system ]; then
            # The unit file is gone already: drop the table directly.
            nft delete table ip sedir 2>/dev/null || true
            systemctl daemon-reload || true
        fi
        ;;
    purge)
        for unit in $UNITS; do
            deb-systemd-helper purge "$unit" >/dev/null || true
        done
        rm -rf /var/lib/sedir
        ;;
esac

exit 0
