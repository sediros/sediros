[Unit]
Description=Sisura: initial UFW policy (first boot)
After=ufw.service
Before=ssh.service network-online.target
ConditionPathExists=!/var/lib/sisura/ufw-initialized

[Service]
Type=oneshot
ExecStart=/usr/sbin/ufw --force reset
ExecStart=/usr/sbin/ufw default deny incoming
ExecStart=/usr/sbin/ufw default allow outgoing
ExecStart=/usr/sbin/ufw default deny routed
ExecStart=/usr/sbin/ufw limit in 22/tcp comment "sisura-ssh"
ExecStart=/usr/sbin/ufw logging low
ExecStart=/usr/sbin/ufw --force enable
# 'ufw reset' leaves *.rules.<timestamp> backups behind.
ExecStartPost=/bin/sh -c 'rm -f /etc/ufw/*.rules.[0-9]*'
ExecStartPost=/usr/bin/install -D -m 0644 /dev/null /var/lib/sisura/ufw-initialized
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
