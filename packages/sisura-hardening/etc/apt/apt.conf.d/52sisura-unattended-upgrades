// Sisura: install Debian security updates automatically (apt-daily timers).
// Read after 20auto-upgrades / 50unattended-upgrades, so these values win.

APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";

// Security archive only. Point releases and other repositories are left to
// the admin ('apt upgrade'), so no feature changes arrive unattended.
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
    "origin=Debian,label=Debian-Security";
};

Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Kernel updates need a reboot; Sisura only reports it (login notice).
// Set to "true" (and Automatic-Reboot-Time) on unattended servers.
Unattended-Upgrade::Automatic-Reboot "false";
