#!/bin/sh
# Sisura live: console autologin drop-ins, generated at boot only when the
# kernel was started with boot=live. Writes to the generator output dir
# (under /run), never to /etc.
set -eu

out="${1:?usage: $0 normal-dir [early-dir] [late-dir]}"
cmdline="${SISURA_LIVE_CMDLINE:-/proc/cmdline}"   # override for tests

grep -qw 'boot=live' "$cmdline" || exit 0

user="$(sed -n 's/^USER=//p' /etc/sisura/build-info 2>/dev/null)"
echo "$user" | grep -Eqx '[a-z_][a-z0-9_-]{0,31}' || exit 0

mkdir -p "$out/getty@tty1.service.d" "$out/serial-getty@.service.d"
cat > "$out/getty@tty1.service.d/50-sisura-live.conf" <<UNIT
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -f -- \\\\u' --noclear --autologin $user %I \$TERM
UNIT
cat > "$out/serial-getty@.service.d/50-sisura-live.conf" <<UNIT
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -f -- \\\\u' --keep-baud --autologin $user 115200,57600,38400,9600 - \$TERM
UNIT
