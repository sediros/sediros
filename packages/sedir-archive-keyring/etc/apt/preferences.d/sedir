# Only SedirOS's own packages may come from the SedirOS repository.
#
# Matched by host name, not by the Origin field of the Release file: the
# host is in sources.list, the Origin is chosen by whoever signs. A stolen
# signing key can therefore not ship e.g. openssh-server to SedirOS systems.
# Keep the host in sync with sources.list.d/sedir.sources.

Package: sedir-*
Pin: origin "sediros.github.io"
Pin-Priority: 500

Package: *
Pin: origin "sediros.github.io"
Pin-Priority: -1
