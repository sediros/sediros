#!/bin/sh
# SedirOS (sedir-boot-hardening): GRUB superuser from /etc/sedir/grub-password,
# managed with 'sedir-grub-password'. Applied only while 10_linux is replaced
# by 10_sedir_linux, otherwise every entry would need the password and an
# unattended reboot would hang at the menu.
set -e

CONF=/etc/sedir/grub-password
[ -r "$CONF" ] || exit 0

if [ -x /etc/grub.d/10_linux ]; then
    echo "sedir: /etc/grub.d/10_linux is executable, GRUB password NOT applied (run sedir-grub-password set)" >&2
    exit 0
fi

user="$(sed -n 's/^GRUB_SUPERUSER=//p' "$CONF")"
hash="$(sed -n 's/^GRUB_PBKDF2=//p' "$CONF")"
echo "$user" | grep -Eqx '[a-z_][a-z0-9_-]{0,31}' || { echo "sedir: invalid GRUB_SUPERUSER in $CONF" >&2; exit 1; }
echo "$hash" | grep -Eqx 'grub\.pbkdf2\.sha512\.[0-9]+\.[0-9A-F]+\.[0-9A-F]+' || { echo "sedir: invalid GRUB_PBKDF2 in $CONF" >&2; exit 1; }

cat <<GRUB
set superusers="$user"
export superusers
password_pbkdf2 $user $hash
GRUB
