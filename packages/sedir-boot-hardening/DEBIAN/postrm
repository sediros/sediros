#!/bin/sh
# sedir-boot-hardening postrm
set -e

case "$1" in
    remove|purge)
        # Give 10_linux back to Debian before regenerating the menu. Our
        # /etc/grub.d scripts stay until purge (conffiles) but are inert
        # while 10_linux is executable.
        if dpkg-statoverride --list /etc/grub.d/10_linux >/dev/null 2>&1; then
            dpkg-statoverride --remove /etc/grub.d/10_linux
            [ -e /etc/grub.d/10_linux ] && chmod 0755 /etc/grub.d/10_linux
        fi
        [ "$1" = purge ] && rm -f /etc/sedir/grub-password
        if [ -f /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
            update-grub || true
        fi
        ;;
esac

exit 0
