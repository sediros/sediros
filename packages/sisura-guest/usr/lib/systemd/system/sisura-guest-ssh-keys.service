[Unit]
Description=Sisura: SSH key from the VM manager (systemd credential)
Documentation=file:/usr/lib/sisura/guest-ssh-keys
ConditionCredential=sisura.ssh.authorized_keys
After=local-fs.target
Before=ssh.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=sisura.ssh.authorized_keys
ExecStart=/usr/lib/sisura/guest-ssh-keys

[Install]
WantedBy=multi-user.target
